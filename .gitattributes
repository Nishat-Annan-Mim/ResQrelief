# Normalise line endings so Windows/macOS/Linux checkouts stop showing every
# file as modified. Git stores LF in the repo; each machine gets its native
# endings in the working tree.
* text=auto

# Explicit for the file types in this project.
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf

# Binary — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.jfif  binary
*.gif   binary
*.pdf   binary
*.ico   binary
